# Plantilla de las credenciales de firma. Copia este archivo como
# android/keystore.properties y rellena tus propios valores.
#
# El archivo real NO se sube al repositorio (está en .gitignore), y el .jks
# tampoco. Guarda el .jks y estas contraseñas en un gestor de contraseñas:
# si los pierdes, Google Play no deja publicar nunca más una actualización
# de com.pixelminas.game.
#
# Para crear el almacén (desde la carpeta android/):
#   keytool -genkeypair -v -keystore pixelminas.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias pixelminas

storeFile=pixelminas.jks
storePassword=TU_CONTRASEÑA_DEL_ALMACEN
keyAlias=pixelminas
keyPassword=TU_CONTRASEÑA_DE_LA_CLAVE
